<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fitsSystemWindows="true">

    <!-- 接続画面 -->
    <ScrollView
        android:id="@+id/connectPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textColor="@color/text"
                android:textSize="32sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/statusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="準備中…"
                android:textColor="@color/accent"
                android:textSize="18sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:layout_marginBottom="8dp"
                android:text="登録済みのPC"
                android:textColor="@color/text_dim"
                android:textSize="14sp" />

            <LinearLayout
                android:id="@+id/deviceList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <Button
                android:id="@+id/pairButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:backgroundTint="@color/accent"
                android:minHeight="64dp"
                android:text="＋ 新しいPCを登録する"
                android:textColor="@color/bg"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/pairHelp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@color/panel"
                android:lineSpacingExtra="4dp"
                android:padding="16dp"
                android:textColor="@color/text"
                android:textSize="15sp"
                android:visibility="gone" />

            <Button
                android:id="@+id/quitButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="40dp"
                android:backgroundTint="@color/button_bg"
                android:text="アプリを終了"
                android:textColor="@color/text_dim" />
        </LinearLayout>
    </ScrollView>

    <!-- 読書中画面（ノールック用：真っ黒・大きな文字） -->
    <LinearLayout
        android:id="@+id/readerPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/readerTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="@color/text_dim"
            android:textSize="14sp" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="音量＋　次へ"
                    android:textColor="@color/text_dim"
                    android:textSize="26sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="音量−　戻る"
                    android:textColor="@color/text_dim"
                    android:textSize="26sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/flashText"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:alpha="0"
                android:background="@color/bg"
                android:gravity="center"
                android:textColor="@color/accent"
                android:textSize="72sp"
                android:textStyle="bold" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/directionButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.3"
                android:backgroundTint="@color/button_bg"
                android:textAllCaps="false"
                android:textColor="@color/text_dim"
                android:textSize="13sp" />

            <Button
                android:id="@+id/screenButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:backgroundTint="@color/button_bg"
                android:textColor="@color/text_dim"
                android:textSize="13sp" />

            <Button
                android:id="@+id/disconnectButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="0.7"
                android:backgroundTint="@color/button_bg"
                android:text="切断"
                android:textColor="@color/text_dim"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
